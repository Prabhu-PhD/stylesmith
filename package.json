{
  "name": "stylesmith",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StyleSmith — named, reusable styles for PowerPoint (text, shape, geometry, tables) with a design-token layer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:certs": "office-addin-dev-certs install"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.54.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.377",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "office-addin-dev-certs": "^1.13.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
